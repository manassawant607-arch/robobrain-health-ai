{
  "name": "robobrain-health-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RoboBrain Health AI — an agentic, autonomous healthcare platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
